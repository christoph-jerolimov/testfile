{
  "name": "@testfile.dev/scriptc-native",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental: testfile-report, a native binary with no JavaScript engine in it, compiled by scriptc",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "scriptc build src/report.ts -o dist/testfile-report",
    "coverage": "scriptc coverage src/report.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.scriptc',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "scriptc": "^0.0.32"
  }
}
