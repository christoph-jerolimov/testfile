{
  "name": "@testfile.dev/eve",
  "version": "0.1.0",
  "description": "eve: ask questions about your recorded Testfile runs, answered by an agent over the MCP tools",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "eve": "./dist/eve.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@testfile.dev/core": "^0.1.0",
    "@testfile.dev/mcp": "^0.1.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
