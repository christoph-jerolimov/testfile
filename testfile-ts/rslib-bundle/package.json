{
  "name": "@testfile.dev/rslib-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental: the testfile CLI bundled into one file with Rslib (Rspack)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebundle": "npm run build --workspace @testfile.dev/cli --prefix ../..",
    "bundle": "rslib build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rspack/core": "^2.1.10"
  }
}
