{
  "name": "@testfile.dev/sync",
  "version": "0.0.0",
  "description": "Moving recorded runs between machines: local archives, S3, GitHub and GitLab CI artifacts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "default": "./dist/commands/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@testfile.dev/core": "^0.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
