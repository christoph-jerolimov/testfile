{
  "name": "@testfile/cli",
  "version": "0.1.0",
  "description": "The testfile command line: run the tests a Testfile describes, and read the runs that came out",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "testfile": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@testfile/core": "^0.1.0",
    "@testfile/mcp": "^0.1.0",
    "@testfile/runner": "^0.1.0",
    "@testfile/sync": "^0.1.0",
    "@testfile/web": "^0.1.0",
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "@testfile/tui": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
