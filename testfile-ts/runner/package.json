{
  "name": "@testfile/runner",
  "version": "0.1.0",
  "description": "Runs the tests a Testfile describes: the suite, its services, containers and clusters",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@testfile/core": "0.1.0",
    "@testfile/schema": "0.1.0",
    "ajv": "^8.17.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
