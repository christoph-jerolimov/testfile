{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../core-ts"
    },
    {
      "path": "../runner-ts"
    },
    {
      "path": "../sync-ts"
    },
    {
      "path": "../mcp-ts"
    },
    {
      "path": "../tui-ts"
    },
    {
      "path": "../web-ts"
    }
  ]
}
