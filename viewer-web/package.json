{
  "name": "@testfile/viewer-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web viewer for recorded Testfile runs, served by `testfile serve`",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "tsc -p tsconfig.test.json && node --test \"out/**/*.test.js\"",
    "test": "npm run typecheck && npm run test:unit && npm run build",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  }
}
