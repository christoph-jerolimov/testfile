# yaml-language-server: $schema=schema/testfile.schema.json
# This repository's own CI, described as a Testfile. The GitHub workflow
# (.github/workflows/ci.yaml) runs it through the bundled action, so the
# format, the runner and the action are all exercised by every build.
version: 0
name: testfile-monorepo
env:
  CI: true
ports:
  e2e: random
test:
  name: ci
  sequence:
    - name: install
      tags: [setup]
      command: npm ci --no-audit --no-fund
    - name: checks
      parallel:
        # oxlint and oxfmt over every JavaScript and TypeScript workspace;
        # `npm run lint:fix` and `npm run format` fix what they report.
        - name: lint
          tags: [fast, lint]
          command: npm run lint
          inputs: &sources
            # every workspace's own sources - a "**/*.ts" from the root would
            # walk node_modules
            - "*/src/**/*.{ts,tsx,mjs,cjs}"
            - "testfile-ts/*/src/**/*.ts"
            - "*/scripts/**/*.{ts,mjs}"
            - "*/e2e/**/*.ts"
            - "*/*.{ts,mjs}"
            - action/*.mjs
            - gitlab/*.mjs
            - scripts/*.mjs
            - .oxlintrc.json
            - .oxfmtrc.json
        - name: format
          tags: [fast, lint]
          command: npm run format:check
          inputs: *sources
        - name: schema
          tags: [fast, schema]
          command: npm test --workspace schema
          inputs:
            - schema/**
            - Testfile
            - examples/**/Testfile
            # the complete Testfiles printed in the docs are validated too,
            # and the files the website's wizard is expected to produce
            - docs/**.md
            - website/e2e/expected/**
        # A dependency from one workspace on another has to resolve to that
        # workspace rather than to the registry, where none of them is
        # published. npm has no `workspace:` protocol to say so, only ranges
        # that happen to match - and nothing in npm keeps them matching when
        # a version is bumped, so this does.
        - name: workspaces
          tags: [fast, unit]
          command: node --test scripts/workspaces.test.mjs
          inputs:
            - scripts/workspaces.test.mjs
            - package.json
            - package-lock.json
            - "*/package.json"
            - testfile-ts/*/package.json
        - name: website
          tags: [docs]
          command: npm run build --workspace website
          inputs:
            - website/**
            - docs/**
            # the specification pages are rendered from these files
            - spec/**
            - examples/**
            - package-lock.json
        # Everything in this workspace is TypeScript; the two checkers are
        # typechecked by being compiled, this covers the site's own sources
        # and the browser suite. After the build, not beside it: both drive
        # astro, and two of them write its content store at once.
        - name: website-types
          tags: [fast, docs]
          needs: [website]
          command: npm run typecheck --workspace website
        # Every internal link of the built site has to point at a page and an
        # anchor that exist - the docs link each other by heading.
        - name: links
          tags: [docs]
          needs: [website]
          command: npm run check:links --workspace website
        # llms.txt indexes the site for a model; an index that quietly
        # misses a page is worse than none, since whoever reads it believes
        # it is complete.
        - name: llms
          tags: [docs]
          needs: [website]
          command: npm run check:llms --workspace website
        - name: link-checker
          tags: [fast, unit, docs]
          command: npm test --workspace website
          inputs:
            - website/scripts/**
        # Both browser suites need a chromium, and two `playwright install
        # --with-deps` at once fight over the apt lock - so it is fetched
        # once, here, and they wait for it.
        - name: browsers
          tags: [slow, e2e, browser]
          if: ${{ env.TESTFILE_OS }} == linux
          script: |
            if [ ! -d /opt/pw-browsers ]; then
              npx playwright install --with-deps chromium
            fi
        # The "Get started" wizard, driven in a browser: the page is the
        # only thing that knows how to build the file, so the only honest
        # way to check what it produces is to answer its questions. Linux
        # only, like the other browser suite - it needs a chromium.
        - name: website-wizard
          tags: [slow, e2e, browser, docs]
          if: ${{ env.TESTFILE_OS }} == linux
          needs: [website, browsers]
          workdir: website
          script: |
            if [ -d /opt/pw-browsers ]; then
              export PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
            fi
            npx playwright test
          artifacts:
            - test-results/**
        - name: testfile-viewer
          tags: [fast, unit]
          command: npm test --workspace testfile-viewer
          inputs:
            - testfile-viewer/src/**
            - testfile-viewer/package.json
            - testfile-viewer/tsconfig*.json
            - testfile-viewer/vite.config.ts
            - testfile-viewer/index.html
        - name: vscode-extension
          tags: [fast, unit, editor]
          command: npm test --workspace vscode-extension
          inputs:
            - vscode-extension/src/**
            - vscode-extension/package.json
            - vscode-extension/build.mjs
            - schema/testfile.schema.json
        # One build for all TypeScript packages: building the CLI builds
        # everything it references (core, runner, sync, mcp, tui, web), so
        # every step below runs against this one dist. The action only
        # builds @testfile.dev/runner for itself - the full command line is
        # built here, where its tests and the steps that drive it need it.
        - name: build-cli
          tags: [build]
          command: npm run build --workspace @testfile.dev/cli
        # The recorded-run domain everything else reads: built first, since
        # the viewer and its tests compile against it.
        - name: core
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/core
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/core/package.json
            - testfile-ts/core/tsconfig.json
        # Moving runs between machines; needs tar/unzip, so some of its
        # cases skip themselves where those are missing.
        - name: sync
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/sync
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/sync/src/**
            - testfile-ts/sync/package.json
            - testfile-ts/sync/tsconfig.json
        # An assistant's view of the history: no external dependency at
        # all, the MCP wire is written here.
        - name: mcp
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/mcp
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/mcp/src/**
            - testfile-ts/mcp/package.json
            - testfile-ts/mcp/tsconfig.json
        # The only package that needs a renderer (Ink, React); its screen
        # tests compare against the committed .ans files.
        - name: tui
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/tui
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/tui/src/**
            - testfile-ts/tui/screens/**
            - testfile-ts/tui/package.json
            - testfile-ts/tui/tsconfig.json
        - name: web
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/web
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/web/src/**
            - testfile-ts/web/package.json
            - testfile-ts/web/tsconfig.json
        # The second bundler, checked because it can be: Rslib needs nothing
        # beyond npm, where the three packagers need deno, bun or node 25 and
        # stay out of CI. Building it is the test - a bundler that disagrees
        # with esbuild about our dependency graph fails here rather than in
        # somebody's binary - and the result has to actually run.
        #
        # `npx rslib build`, not `npm run bundle`: that script's prebundle
        # rebuilds @testfile.dev/cli, and that build starts by deleting
        # testfile-ts/cli/dist - which `skills` and `examples` are running out
        # of at the same time. The convenience of prebundle is for a human in
        # that folder; here `needs: [build-cli]` has already built it.
        - name: rslib-bundle
          tags: [slow, build]
          needs: [build-cli]
          workdir: testfile-ts/rslib-bundle
          script: |
            npx rslib build
            node dist/testfile.js --version
          inputs:
            - testfile-ts/*/src/**
            - testfile-ts/rslib-bundle/rslib.config.ts
            - testfile-ts/rslib-bundle/package.json
            - testfile-ts/cli/bundle-stub.mjs
        # `eve` asks the model about recorded runs over the same tools the MCP
        # server serves. Its own tests never reach the network: the adapter is
        # checked against what `testfile mcp` answers for the same call.
        #
        # `npm test`, not `node --test dist/...` like its neighbours: nothing
        # else depends on this package, so no earlier step builds it - and an
        # unbuilt dist/ makes `node --test` match no files and pass. Its
        # pretest builds it (and core and mcp, which it references).
        - name: eve
          tags: [fast, unit]
          command: npm test --workspace @testfile.dev/eve
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/mcp/src/**
            - testfile-ts/eve/src/**
            - testfile-ts/eve/package.json
            - testfile-ts/eve/tsconfig.json
        - name: cli
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/cli
          command: node --test "dist/**/*.test.js"
          inputs:
            - testfile-ts/core/src/**
            - testfile-ts/sync/src/**
            - testfile-ts/mcp/src/**
            - testfile-ts/tui/src/**
            - testfile-ts/web/src/**
            - testfile-ts/runner/src/**
            - testfile-ts/cli/src/**
            - testfile-ts/cli/package.json
            - testfile-ts/cli/tsconfig.json
        # npm test --workspace @testfile.dev/runner would rebuild via pretest; the tests
        # run against the one build above so nothing rewrites dist mid-run.
        - name: runner-tests
          tags: [fast, unit]
          needs: [build-cli]
          workdir: testfile-ts/runner
          command: node --test "dist/**/*.test.js"
        # The cases are written for a POSIX shell and some of them need a
        # container engine, so they stay off Windows; what the runner does
        # with paths and processes there is covered by the unit tests above.
        - name: conformance
          tags: [slow, conformance]
          if: ${{ env.TESTFILE_OS }} != win32
          needs: [build-cli]
          command: npm test --workspace conformance
        # The labels the GitHub Action derives from its context decide how a
        # recorded CI run can be found again, so the derivation is pinned.
        - name: action-labels
          tags: [fast, action]
          command: node --test action/labels.test.mjs
          inputs:
            - action/labels.mjs
            - action/labels.test.mjs
        # The commit statuses the action writes end up in the pull request's
        # checks, and a required check keyed on a context that quietly
        # changed shape blocks merges - so the shape is pinned too.
        - name: action-statuses
          tags: [fast, action]
          command: node --test action/statuses.test.mjs
          inputs:
            - action/statuses.mjs
            - action/statuses.test.mjs
            - action/record.mjs
        # The GitLab template derives the same kind of labels from its own
        # context, in bash inside the template - the script is driven
        # against a fake GitLab context with npx and git stubbed out, so
        # the derivation is pinned like the action's. Not on Windows: the
        # test needs a bash.
        - name: gitlab-template
          tags: [fast, action]
          if: ${{ env.TESTFILE_OS }} != win32
          command: node --test gitlab/template.test.mjs
          inputs:
            - gitlab/testfile.gitlab-ci.yml
            - gitlab/template.test.mjs
        # No CI can apply the Tekton manifests to a cluster, so their shape
        # is pinned instead: every $(params.x) the steps use is declared
        # (and vice versa), the example pipeline passes only parameters the
        # task has, and the docs name every parameter.
        - name: tekton
          tags: [fast, tekton]
          command: node --test scripts/tekton.test.mjs
          inputs:
            - tekton/**
            - scripts/tekton.test.mjs
            - docs/tekton.md
        # The skills tell an assistant which commands to run; this checks
        # every command and flag they name against the CLIs' own --help,
        # so a renamed flag cannot turn the advice into nonsense.
        - name: skills
          tags: [fast, docs]
          # the check asks the CLI for its own help, so it has to be built
          needs: [build-cli]
          command: node --test .claude/skills/skills.test.mjs
          inputs:
            - .claude/skills/**
            - testfile-ts/cli/src/**
        # Runs nothing: it maps the specification's sections onto the case
        # ids, so a new spec section cannot arrive without a case.
        - name: conformance-coverage
          tags: [fast, conformance]
          command: npm run coverage --workspace conformance
          inputs:
            - conformance/coverage*.mjs
            - conformance/cases/*/expected.yaml
            - spec/TESTFILE.md
            - spec/RESULTS.md
        # The guides on the website render these files, so they
        # must stay valid.
        - name: examples
          tags: [fast, docs]
          needs: [build-cli]
          script: |
            for dir in examples/*/; do
              node testfile-ts/cli/dist/cli.js validate "$dir"
            done
        # The Jenkins shared library's fast layer: its suite and the
        # fixtures its seeded jobs run stay valid, and the REST verifier is
        # checked against a stubbed Jenkins. The real controllers
        # (integrations/jenkins/Testfile) are not started here - that suite
        # pulls images, plugins and Node, and runs on demand:
        # testfile start integrations/jenkins
        - name: jenkins-library
          tags: [fast, integrations]
          needs: [build-cli]
          script: |
            node testfile-ts/cli/dist/cli.js validate integrations/jenkins
            for dir in integrations/jenkins/test/fixtures/*/; do
              node testfile-ts/cli/dist/cli.js validate "$dir"
            done
            node --test integrations/jenkins/test/verify.test.mjs
          inputs:
            - integrations/jenkins/**
        # The web viewer's Playwright suite, dogfooding the format: the
        # CLI's serve command runs as a service over the committed e2e
        # fixture, and the browser tests (incl. screenshot comparison) hit
        # it. Locally the pre-installed Playwright browsers are used; on CI
        # the pinned chromium build is downloaded, so rendering matches the
        # committed screenshots everywhere.
        # Linux only: the committed screenshots are rendered with the fonts of
        # that platform, so comparing them elsewhere reports differences that
        # say nothing about the viewer.
        - name: viewer-e2e
          tags: [slow, e2e, browser]
          if: ${{ env.TESTFILE_OS }} == linux
          needs: [build-cli, testfile-viewer, browsers]
          workdir: testfile-viewer
          services:
            viewer:
              command: node ../testfile-ts/cli/dist/cli.js serve e2e/fixture --port ${{ ports.e2e }} --name "E2E Fixture"
              ready:
                tcp: ${{ ports.e2e }}
                timeout: 30s
          env:
            TESTFILE_E2E_URL: http://127.0.0.1:${{ ports.e2e }}
          script: |
            if [ -d /opt/pw-browsers ]; then
              export PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
            fi
            npx playwright test
          artifacts:
            - test-results/**
        # What the dedicated action self-test job used to check: running the
        # smoke Testfile produces a passing JUnit report.
        - name: action-smoke
          tags: [action]
          needs: [build-cli]
          script: |
            out=$(mktemp)
            node testfile-ts/cli/dist/cli.js start .github/action-smoke --reporter junit --output "$out"
            grep -q '<testcase name="hello"' "$out"
            grep -q 'failures="0"' "$out"
            rm -f "$out"
            # Reporting the run must never be what fails a build: without a
            # token there is nothing to post to, and that is not an error.
            GITHUB_TOKEN= node action/statuses.mjs .github/action-smoke
