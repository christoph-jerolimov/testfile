---
import { Code } from "astro:components";
import { examples, examplesRepoUrl } from "../../examples";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return examples.map((example) => ({ params: { slug: example.id }, props: { example } }));
}

const { example } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={example.meta.title} description={example.meta.summary}>
  <h1>
    {example.meta.title}
    <span class="stack">{example.meta.stack}</span>
  </h1>
  <p class="summary">{example.meta.summary}</p>
  <ul class="highlights">
    {
      example.meta.highlights.map((point) => (
        <li set:html={point.replace(/`([^`]+)`/g, "<code>$1</code>")} />
      ))
    }
  </ul>
  <Code
    code={example.testfile}
    lang="yaml"
    themes={{ light: "github-light", dark: "github-dark" }}
  />
  <p class="source">
    <a href={`${examplesRepoUrl}/${example.id}`}>Browse this example on GitHub →</a>
  </p>
  <p class="outro">
    Copy it into your project, adjust the commands, run <code>testfile start</code>. Missing your
    stack? <a href="https://github.com/christoph-jerolimov/testfile/issues">Open an issue</a> — or
    start from <a href={`${base}/docs/getting-started`}>Getting started</a> and let
    <code>testfile init</code> write a first version for you.
  </p>
</Layout>

<style>
  h1 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stack {
    flex: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--muted);
  }
  .summary {
    color: var(--muted);
    max-width: 42rem;
    margin: 0 0 1.25rem;
  }
  .highlights {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.93rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.1rem;
    margin: 0.5rem 0;
    color: var(--muted);
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4em;
    height: 0.4em;
    border-radius: 1px;
    background: var(--accent);
  }
  /* One example per page, so the file is shown whole rather than in a
     scrollable box the way the stacked gallery needed. */
  .source {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
  }
  .outro {
    margin: 2.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
</style>
