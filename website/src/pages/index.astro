---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Home" description="Testfile — a declarative YAML format for running your project's tests.">
  <h1>Testfile</h1>
  <p>
    A declarative YAML format that describes how your project runs its tests:
    a tree of commands and scripts running in sequence, in parallel or as a
    matrix — with the services they need (the app under test, databases as
    containers) started, health-checked and gracefully stopped for you.
  </p>
  <pre><code>version: 1
ports:
  web: random
services:
  web:
    command: npm start
    env:
      PORT: $&lcub;&lcub; ports.web &rcub;&rcub;
    ready:
      http: http://localhost:$&lcub;&lcub; ports.web &rcub;&rcub;/healthz
test:
  sequence:
    - name: lint
      command: npm run lint
    - name: e2e
      command: npm run test:e2e</code></pre>
  <h2>Documentation</h2>
  <ul>
    {
      docs.map((doc) => (
        <li>
          <a href={`${base}/docs/${doc.id}`}>{doc.data.title}</a>
          {doc.data.description && <span> — {doc.data.description}</span>}
        </li>
      ))
    }
  </ul>
</Layout>
