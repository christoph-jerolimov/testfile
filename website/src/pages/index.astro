---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const example = `version: 0
ports:
  web: random
services:
  web:
    command: npm start
    env:
      PORT: \${{ ports.web }}
    ready:
      http: http://localhost:\${{ ports.web }}/healthz
test:
  sequence:
    - name: lint
      command: npm run lint
    - name: e2e
      command: npm run test:e2e`;
---

<Layout
  title="Home"
  description="Testfile — a declarative YAML format for running your project's tests."
  sidebar={false}
>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">One file. Your whole test suite.</p>
      <h1>
        Describe how your project runs its tests — <span class="grad">declaratively</span>.
      </h1>
      <p class="lead">
        A YAML format for suites of nested commands and scripts running in
        sequence, in parallel or as a matrix — with the services they need
        (the app under test, databases as containers) started,
        health-checked and gracefully stopped for you.
      </p>
      <div class="cta">
        <a class="button primary" href={`${base}/docs/getting-started`}>Get started</a>
        <a class="button ghost" href={`${base}/docs/index`}>What is a Testfile?</a>
      </div>
      <ul class="points">
        <li>Sequences, parallel groups, matrices &amp; result caching</li>
        <li>Services with readiness checks, ports and clean teardown</li>
        <li>Runner CLI, TUI, web viewer, GitHub Action, VS Code</li>
      </ul>
    </div>
    <div class="hero-code">
      <div class="window">
        <div class="titlebar">
          <span class="dot red"></span>
          <span class="dot blue"></span>
          <span class="dot plain"></span>
          <span class="fname">Testfile</span>
        </div>
        <Code code={example} lang="yaml" themes={{ light: "github-light", dark: "github-dark" }} />
      </div>
      <p class="run-hint"><code>testfile run</code> — that's the whole CI job.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 3rem 0 2rem;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent-red);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-red));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin: 1.1rem 0 1.6rem;
    font-size: 1.06rem;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .button {
    display: inline-block;
    padding: 0.55rem 1.15rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .button.primary {
    background: var(--accent);
    color: #ffffff;
  }
  .button.primary:hover {
    filter: brightness(1.1);
  }
  .button.ghost {
    border-color: var(--border);
    color: var(--fg);
  }
  .button.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .points {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    color: var(--muted);
  }
  .points li {
    position: relative;
    padding-left: 1.3rem;
    margin: 0.45rem 0;
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.55em;
    height: 0.55em;
    border-radius: 2px;
    background: var(--accent);
  }
  .points li:nth-child(2)::before {
    background: var(--accent-red);
  }
  .window {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(9, 105, 218, 0.08);
    background: var(--code-bg);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
  .dot.red {
    background: var(--accent-red);
  }
  .dot.blue {
    background: var(--accent);
  }
  .dot.plain {
    background: var(--border);
  }
  .fname {
    margin-left: 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .window :global(pre) {
    margin: 0;
    border: none;
    border-radius: 0;
    padding: 1rem 1.1rem;
    font-size: 0.85rem;
  }
  .run-hint {
    margin: 0.8rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }
  }
</style>
