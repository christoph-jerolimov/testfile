---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const example = `version: 0
ports:
  web: random
services:
  web:
    command: npm start
    env:
      PORT: \${{ ports.web }}
    ready:
      http: http://localhost:\${{ ports.web }}/healthz
test:
  sequence:
    - name: lint
      command: npm run lint
    - name: e2e
      command: npm run test:e2e`;
---

<Layout
  title="Home"
  description="Testfile — a declarative YAML format for running your project's tests."
  sidebar={false}
>
  <section class="hero">
    <div class="hero-text">
      <h1>
        Declare how your project is tested — <span class="grad">don't script it</span>.
      </h1>
      <p class="lead">
        A YAML file that describes the whole test setup, with the services
        your tests depend on started and health-checked for you. Every run
        is recorded — and even CI runs can be inspected locally.
      </p>
      <div class="cta">
        <a class="button primary" href={`${base}/docs/getting-started`}>Get started</a>
        <a class="button ghost" href={`${base}/docs/index`}>What is a Testfile?</a>
      </div>
    </div>
    <div class="hero-code">
      <div class="window">
        <div class="titlebar">
          <span class="dot red"></span>
          <span class="dot blue"></span>
          <span class="dot plain"></span>
          <span class="fname">Testfile</span>
        </div>
        <Code code={example} lang="yaml" themes={{ light: "github-light", dark: "github-dark" }} />
      </div>
      <p class="run-hint"><code>testfile run</code> — that's the whole CI job.</p>
    </div>
  </section>

  <section class="features">
    <div class="feature">
      <h3><span class="marker blue"></span>Simple definitions</h3>
      <p>
        The setup is easy: a name and a command is a test, and
        <a href={`${base}/docs/getting-started`}><code>testfile init</code></a>
        writes the first version for you. Plain YAML, validated by a
        schema, readable in every code review.
      </p>
    </div>
    <div class="feature">
      <h3><span class="marker red"></span>Scales with requirements</h3>
      <p>
        Grow from one command to sequences, parallel groups and
        <a href={`${base}/docs/matrix`}>matrix tests</a> — with filters,
        retries, conditions and
        <a href={`${base}/docs/writing-tests#result-caching`}>result caching</a>
        when the suite gets big. The same file runs locally, in watch mode
        and on CI.
      </p>
    </div>
    <div class="feature">
      <h3><span class="marker blue"></span>Manages your services</h3>
      <p>
        The app under test and databases as containers are just
        <a href={`${base}/docs/services`}>dependencies of a test</a>: started
        on demand, health-checked before anything runs, gracefully stopped
        afterwards — with <a href={`${base}/docs/env-and-ports`}>random ports</a>
        wired in for parallel-safe runs.
      </p>
    </div>
  </section>

  <section class="viewer">
    <h2>Unified viewer for local and CI runs</h2>
    <p class="viewer-lead">
      Browse recorded runs in the terminal (<code>testfile-viewer tui</code>)
      or in the browser (<code>testfile-viewer serve</code>): statuses,
      durations, per-test logs, service logs — and <em>why</em> a test ran
      or came from the cache. <code>testfile-viewer github sync</code>
      brings <a href={`${base}/docs/github-action`}>GitHub Actions runs</a>
      into the same history.
    </p>
    <div class="shot">
      <img
        src={`${base}/screenshots/viewer.png`}
        alt="The Testfile web viewer showing a recorded run: the runs table, per-test statuses with cache reasons, a service row and the merged log"
        width="1280"
        height="660"
        loading="lazy"
      />
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 3rem 0 1rem;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-red));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin: 1.1rem 0 1.6rem;
    font-size: 1.06rem;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .button {
    display: inline-block;
    padding: 0.55rem 1.15rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .button.primary {
    background: var(--accent);
    color: #ffffff;
  }
  .button.primary:hover {
    filter: brightness(1.1);
  }
  .button.ghost {
    border-color: var(--border);
    color: var(--fg);
  }
  .button.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .window {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(9, 105, 218, 0.08);
    background: var(--code-bg);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
  }
  .dot.red {
    background: var(--accent-red);
  }
  .dot.blue {
    background: var(--accent);
  }
  .dot.plain {
    background: var(--border);
  }
  .fname {
    margin-left: 0.4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .window :global(pre) {
    margin: 0;
    border: none;
    border-radius: 0;
    padding: 1rem 1.1rem;
    font-size: 0.85rem;
  }
  .run-hint {
    margin: 0.8rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    padding: 2.5rem 0 1rem;
  }
  .feature {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    background: var(--code-bg);
  }
  .feature h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.5rem;
    font-size: 1.02rem;
  }
  .marker {
    width: 0.6em;
    height: 0.6em;
    border-radius: 2px;
    flex: none;
  }
  .marker.blue {
    background: var(--accent);
  }
  .marker.red {
    background: var(--accent-red);
  }
  .feature p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--muted);
  }

  .viewer {
    padding: 2.5rem 0 1rem;
    text-align: center;
  }
  .viewer h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
  }
  .viewer-lead {
    max-width: 44rem;
    margin: 0 auto 1.75rem;
    color: var(--muted);
  }
  .shot {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(9, 105, 218, 0.1);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 1.5rem;
    }
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
