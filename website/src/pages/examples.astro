---
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { Code } from "astro:components";
import { parse } from "yaml";
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/christoph-jerolimov/testfile/blob/main/examples";

// The gallery renders the real Testfiles from the repository's examples/
// folder (validated in CI), so the page can never drift from them.
// fileURLToPath, not .pathname: on Windows the latter keeps the URL's
// leading slash ("/D:/...") and readdirSync cannot open that.
const examplesDir = fileURLToPath(new URL("../../../examples/", import.meta.url));

interface Meta {
  order: number;
  title: string;
  stack: string;
  summary: string;
  highlights: string[];
}

const examples = readdirSync(examplesDir, { withFileTypes: true })
  .filter((entry) => entry.isDirectory())
  .map((entry) => {
    const dir = join(examplesDir, entry.name);
    const meta = parse(readFileSync(join(dir, "example.yaml"), "utf8")) as Meta;
    return {
      id: entry.name,
      meta,
      testfile: readFileSync(join(dir, "Testfile"), "utf8").replace(
        /^# yaml-language-server:.*\n/,
        ""
      ),
    };
  })
  .sort((a, b) => a.meta.order - b.meta.order);
---

<Layout
  title="Examples"
  description="Ready-to-copy Testfiles for common stacks: pytest + PostgreSQL, Playwright, Go with containers, matrix builds and monorepos."
  sidebar={false}
>
  <section class="intro">
    <h1>Examples</h1>
    <p>
      Complete, working Testfiles for the setups people ask about most. Copy
      one into your project, adjust the commands, run <code>testfile run</code>.
      Every file here lives in the
      <a href={repo}>examples folder</a> of the repository and is validated
      against the schema on every CI run.
    </p>
    <nav class="jump">
      {examples.map((example) => <a href={`#${example.id}`}>{example.meta.title}</a>)}
    </nav>
  </section>

  {
    examples.map((example) => (
      <section class="example" id={example.id}>
        <header>
          <div>
            <h2>{example.meta.title}</h2>
            <p class="summary">{example.meta.summary}</p>
          </div>
          <span class="stack">{example.meta.stack}</span>
        </header>
        <div class="body">
          <ul class="highlights">
            {example.meta.highlights.map((point) => (
              <li set:html={point.replace(/`([^`]+)`/g, "<code>$1</code>")} />
            ))}
          </ul>
          <div class="code">
            <Code
              code={example.testfile}
              lang="yaml"
              themes={{ light: "github-light", dark: "github-dark" }}
            />
          </div>
        </div>
        <p class="source">
          <a href={`${repo}/${example.id}`}>Browse this example on GitHub →</a>
        </p>
      </section>
    ))
  }

  <section class="outro">
    <p>
      Missing your stack?
      <a href="https://github.com/christoph-jerolimov/testfile/issues">Open an issue</a>
      — or start from <a href={`${base}/docs/getting-started`}>Getting started</a>
      and let <code>testfile init</code> write a first version for you.
    </p>
  </section>
</Layout>

<style>
  .intro {
    padding: 2rem 0 0.5rem;
    max-width: 46rem;
  }
  .intro h1 {
    margin: 0 0 0.6rem;
  }
  .intro p {
    color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump a {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--fg);
  }
  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .example {
    padding: 2.5rem 0 0;
    scroll-margin-top: 1rem;
  }
  .example header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .example h2 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    max-width: 42rem;
  }
  .stack {
    flex: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 1.5rem;
    align-items: start;
    margin-top: 1.25rem;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.93rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.1rem;
    margin: 0.5rem 0;
    color: var(--muted);
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4em;
    height: 0.4em;
    border-radius: 1px;
    background: var(--accent);
  }
  .code :global(pre) {
    max-height: 32rem;
    overflow: auto;
    font-size: 0.82rem;
  }
  .source {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
  }
  .outro {
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
