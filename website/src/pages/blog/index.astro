---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Rendered at build time; UTC so the date shown is the date in the
// frontmatter, whatever timezone the build ran in.
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Layout title="Blog" description="News and guides around Testfile." sidebar={false}>
  <h1>Blog</h1>
  <p>
    News and guides around Testfile — also as an
    <a href={`${base}/blog/rss.xml`}>RSS feed</a>.
  </p>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`${base}/blog/${post.id}`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>
            {formatDate(post.data.date)}
          </time>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .posts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .posts li {
    margin-bottom: 2rem;
  }
  .posts li > a {
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }
  .posts li > a:hover {
    text-decoration: underline;
  }
  .posts time {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .posts li > p {
    margin: 0.25rem 0 0;
  }
</style>
