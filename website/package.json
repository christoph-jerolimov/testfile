{
  "name": "@testfile.dev/website",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation website for Testfile, built with Astro from the docs/ folder",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck": "astro sync && tsc -p tsconfig.json --noEmit",
    "precheck:links": "npm run build:scripts",
    "check:links": "node out/check-links.js dist",
    "precheck:llms": "npm run build:scripts",
    "check:llms": "node out/check-llms.js dist",
    "pretest": "npm run build:scripts",
    "test": "node --test \"out/*.test.js\"",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "astro": "^7.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
