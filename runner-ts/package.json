{
  "name": "@testfile/runner",
  "version": "0.1.0",
  "description": "CLI runner for Testfile / testfile.yaml (inspect recorded runs with @testfile/viewer-ts)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "testfile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@testfile/schema": "0.1.0",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
