{
  "name": "@testfile/viewer-ts",
  "version": "0.1.0",
  "description": "Read-only viewer tooling over recorded Testfile runs: history, TUI, web-viewer server and run transfer",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "testfile-viewer": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@testfile/core": "0.1.0",
    "@testfile/mcp": "0.1.0",
    "@testfile/sync": "0.1.0",
    "@testfile/tui": "0.1.0",
    "@testfile/web": "0.1.0",
    "commander": "^15.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "@playwright/test": "1.62.1"
  }
}
