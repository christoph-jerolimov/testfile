// Testfile on Jenkins (declarative pipeline).
//
// The runner does the orchestration - services, parallelism, matrices -
// so the pipeline stays a single stage. The recorded run is archived so
// it can be imported into a local history with:
//   testfile-viewer archive import <downloaded-run.zip>
pipeline {
  agent { docker { image 'node:22' } }

  stages {
    stage('Install') {
      steps {
        sh 'npm ci --no-audit --no-fund'
      }
    }
    stage('Testfile') {
      steps {
        sh 'npx --yes @testfile/runner start --reporter junit --output junit.xml'
      }
    }
  }

  post {
    always {
      junit 'junit.xml'
      archiveArtifacts artifacts: '.testfile/runs/**', allowEmptyArchive: true
    }
  }
}
