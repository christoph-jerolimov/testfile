version: 0
test:
  name: root
  sequence:
    # the body runs inside the image, not on the host
    - name: in-container
      container:
        image: docker.io/library/busybox:1.36
        engine: podman
      script: |
        test -f marker.txt
        echo "$TESTFILE_MARKER" > from-container.txt
      env:
        TESTFILE_MARKER: hello-from-container
    # nested tests inherit the container of their group
    - name: group
      container:
        image: docker.io/library/busybox:1.36
        engine: podman
      sequence:
        - name: nested
          command: 'grep -q hello-from-container from-container.txt'
    # ... and a sibling without a container still runs on the host
    - name: on-host
      command: 'test -f from-container.txt'
