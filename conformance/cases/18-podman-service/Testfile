version: 0
ports:
  web: random
services:
  httpd:
    container:
      image: docker.io/library/busybox:1.36
      ports:
        - "${{ ports.web }}:8080"
      command: ["httpd", "-f", "-p", "8080"]
    ready:
      tcp: ${{ ports.web }}
      # an exec probe on a container service runs inside that container,
      # where busybox's own httpd lives - this machine has no /bin/httpd
      exec: test -x /bin/httpd
      timeout: 90s
test:
  name: root
  sequence:
    # the published port is reachable from the test (the tcp readiness
    # already gated on it once; this asserts it from inside a test)
    - name: reach-service
      shell: bash
      env:
        PORT: ${{ ports.web }}
      command: 'exec 3<>"/dev/tcp/127.0.0.1/$PORT"'
    # a test-scoped container dependency with a log readiness check
    - name: scoped-container
      services:
        logger:
          container:
            image: docker.io/library/busybox:1.36
            command: ["sh", "-c", "echo logger-ready; sleep 60"]
          ready:
            log: logger-ready
            timeout: 90s
      command: "true"
    # host: true sends the probe back to this machine: it runs in the
    # service's working directory, which is where this Testfile is - the
    # container has no Testfile at its own working directory
    - name: probe-from-the-host
      services:
        outside:
          container:
            image: docker.io/library/busybox:1.36
            command: ["sh", "-c", "sleep 60"]
          ready:
            exec:
              command: test -f Testfile
              host: true
            interval: 100ms
            timeout: 90s
      command: "true"
